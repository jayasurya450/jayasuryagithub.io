<!DOCTYPE html>
<html>
<head>
    <title>Gamer Paradise</title>

    <style>
        body{
            margin:0;
            font-family:Arial;
            background:#111;
            color:white;
            text-align:center;
        }

        header{
            background:#ff0000;
            padding:20px;
            font-size:35px;
            font-weight:bold;
        }

        nav{
            background:#222;
            padding:15px;
        }

        nav a{
            color:white;
            text-decoration:none;
            margin:20px;
            font-size:20px;
        }

        .hero{
            padding:100px 20px;
            background:url('https://images.unsplash.com/photo-1542751371-adc38448a05e');
            background-size:cover;
        }

        .hero h1{
            font-size:60px;
        }

        .games{
            padding:40px;
        }

        .card{
            background:#222;
            margin:20px auto;
            padding:20px;
            width:300px;
            border-radius:15px;
        }

        footer{
            background:black;
            padding:20px;
            margin-top:20px;
        }
    </style>
</head>

<body>

<header>
    Gamer Paradise
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Games</a>
    <a href="#">Esports</a>
    <a href="#">Contact</a>
</nav>

<section class="hero">
    <h1>Welcome Gamers!</h1>
    <p>Explore the world of gaming</p>
</section>

<section class="games">

    <div class="card">
        <h2>BGMI</h2>
        <p>Battle royale action game.</p>
    </div>

    <div class="card">
        <h2>Valorant</h2>
        <p>Popular FPS esports game.</p>
    </div>

    <div class="card">
        <h2>Minecraft</h2>
        <p>Creative sandbox adventure.</p>
    </div>

</section>

<footer>
    © 2026 Gamer Paradise
</footer>

</body>
</html>
